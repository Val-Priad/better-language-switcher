<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BetLaSwi Fluent palette; both themes expose the same dynamic resource keys. -->
    <SolidColorBrush x:Key="PanelPageBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="PanelPinnedBackgroundBrush" Color="#EAF3FB" />
    <SolidColorBrush x:Key="PanelMenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="PanelBorderStrongBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#EDEDED" />
    <SolidColorBrush x:Key="PanelTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PanelTextDimBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="PanelMutedBrush" Color="#5C5C5C" />
    <SolidColorBrush x:Key="PanelLabelBrush" Color="#696969" />
    <SolidColorBrush x:Key="PanelMenuTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="PanelAccentBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="PanelDangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="PanelIconBrush" Color="#616161" />
    <SolidColorBrush x:Key="PanelIcon2Brush" Color="#424242" />
    <SolidColorBrush x:Key="PanelTrackOffBrush" Color="#BFBFBF" />
    <SolidColorBrush x:Key="PanelKnobOffBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelKnobOnBrush" Color="#FFFFFF" />
    <Color x:Key="PanelShadowColor">#66000000</Color>
    <Color x:Key="PanelMenuShadowColor">#55000000</Color>
</ResourceDictionary>
