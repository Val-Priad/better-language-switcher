<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <PathGeometry x:Key="SwiftGeometry" x:Shared="False" Figures="M8 34 C16 30 23 26 30 24 C22 17 14 12 8 6 C25 12 39 19 48 29 C55 29 60 26 64 23 C61 31 55 36 48 39 C41 46 30 53 17 58 C23 49 28 42 31 38 C23 38 15 37 8 34 Z">
        <PathGeometry.Transform>
            <TransformGroup>
                <ScaleTransform ScaleX="6" ScaleY="6" />
                <TranslateTransform X="40" Y="40" />
            </TransformGroup>
        </PathGeometry.Transform>
    </PathGeometry>

    <DrawingImage x:Key="TrayIconOn">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0F6CBD" Geometry="M32,32 H368 Q480,32 480,144 V368 Q480,480 368,480 H144 Q32,480 32,368 V144 Q32,32 144,32 Z" />
                <GeometryDrawing Brush="White" Geometry="{StaticResource SwiftGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <DrawingImage x:Key="TrayIconOff">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#7A8694" Geometry="M32,32 H368 Q480,32 480,144 V368 Q480,480 368,480 H144 Q32,480 32,368 V144 Q32,32 144,32 Z" />
                <GeometryDrawing Brush="White" Geometry="{StaticResource SwiftGeometry}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
