<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- BetLaSwi Fluent palette; both themes expose the same dynamic resource keys. -->
    <SolidColorBrush x:Key="PanelPageBrush" Color="#202020" />
    <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PanelPinnedBackgroundBrush" Color="#263B4E" />
    <SolidColorBrush x:Key="PanelMenuBackgroundBrush" Color="#303030" />
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#252525" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="PanelBorderStrongBrush" Color="#555555" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#3B3B3B" />
    <SolidColorBrush x:Key="PanelTextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="PanelTextDimBrush" Color="#DDDDDD" />
    <SolidColorBrush x:Key="PanelMutedBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="PanelLabelBrush" Color="#A5A5A5" />
    <SolidColorBrush x:Key="PanelMenuTextBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="PanelAccentBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="PanelDangerBrush" Color="#FFB4AB" />
    <SolidColorBrush x:Key="PanelIconBrush" Color="#C7C7C7" />
    <SolidColorBrush x:Key="PanelIcon2Brush" Color="#D5D5D5" />
    <SolidColorBrush x:Key="PanelTrackOffBrush" Color="#636363" />
    <SolidColorBrush x:Key="PanelKnobOffBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelKnobOnBrush" Color="#202020" />
    <Color x:Key="PanelShadowColor">#66000000</Color>
    <Color x:Key="PanelMenuShadowColor">#55000000</Color>
</ResourceDictionary>
